# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to:
# - Backend/.env (use Backend variables)
# - Frontend/.env (use Frontend variables)
#
# Replace the placeholder values with your actual keys and database configs.
# ==============================================================================

# Backend Configuration (Backend/.env)
# gorq_api="your_groq_api_key_here"

# Frontend Configuration (Frontend/.env)
# gorq_api=your_groq_api_key_here
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_password
